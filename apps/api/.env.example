# PostgreSQL database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Replace with a long random secret before production.
JWT_SECRET="dummy-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"

PORT=3000
CLOUD_MODE="dummy"

# Production placeholders — replace when you deploy.
RENDER_SERVICE="expense-tracker-api"
# Receipt attachments are V2; no object-storage bucket in V1.

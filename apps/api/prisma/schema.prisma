generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  phone          String        @unique
  name           String
  recoveryEmail  String        @unique
  passwordHash   String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categories     Category[]
  subCategories  SubCategory[]
  expenses          Expense[]
  budgets           Budget[]
  debtPeople        DebtPerson[]
  debtTransactions  DebtTransaction[]
  changeLogs        ChangeLog[]
}

model Category {
  id        String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?

  @@id([userId, id])
  @@index([userId])
}

model SubCategory {
  id         String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  name       String
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime
  updatedAt  DateTime
  deletedAt  DateTime?

  @@id([userId, id])
  @@index([userId])
}

model Vendor {
  id        String    @id
  name      String
  email     String?
  phone     String?
  address   String?
  gstNumber String?
  isActive  Boolean   @default(true)
  createdAt DateTime
  updatedAt DateTime
  deletedAt DateTime?
}

model Expense {
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseId     String
  expenseDate   String
  categoryId    String
  subCategoryId String?
  amount        Float
  description   String?
  vendorId      String?
  gstRate       Float?
  gstAmount     Float?
  paymentMethod String
  paymentStatus String    @default("Paid")
  billNumber    String?
  notes         String?
  createdAt     DateTime
  updatedAt     DateTime
  deletedAt     DateTime?

  @@unique([userId, expenseId])
  @@index([userId])
}

model ExpenseAttachment {
  id              String    @id
  expenseId       String
  fileName        String
  fileType        String
  fileSize        Int
  cloudObjectPath String?
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?
}

model BusinessProfile {
  id           String   @id
  businessName String?
  address      String?
  phone        String?
  email        String?
  gstNumber    String?
  updatedAt    DateTime
  createdAt    DateTime
}

model Budget {
  id          String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  periodType  String
  periodStart String
  periodEnd   String
  amount      Float
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?

  @@id([userId, id])
  @@unique([userId, categoryId, periodStart, periodEnd])
  @@index([userId])
}

model DebtPerson {
  id           String
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  mobileNumber String
  direction    String
  createdAt    DateTime
  updatedAt    DateTime
  deletedAt    DateTime?

  @@id([userId, id])
  @@unique([userId, mobileNumber])
  @@index([userId])
}

model DebtTransaction {
  id              String
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId        String
  type            String
  amount          Float
  transactionDate String
  note            String?
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?

  @@id([userId, id])
  @@index([userId, personId])
}

model ChangeLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  operation  String
  payload    String
  updatedAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}
